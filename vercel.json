{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/signals/daily",
      "schedule": "0 0 * * 1-5"
    },
    {
      "path": "/api/market/sync-universe",
      "schedule": "*/5 2-7 * * 1-5"
    }
  ]
}