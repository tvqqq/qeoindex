{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "env": {
    "RESEARCH_REPORT_PDF_ALLOWED_HOSTS": "cdn02.wigroup.vn"
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/signals/daily",
      "schedule": "0 0 * * 1-5"
    }
  ]
}
