{
  "name": "qeoindex/market-realtime-worker",
  "description": "QEO-175 Laravel worker that centralizes DNSE realtime ingestion into Supabase.",
  "type": "project",
  "require": {
    "php": "^8.2",
    "guzzlehttp/guzzle": "^7.9",
    "laravel/framework": "^12.0",
    "ratchet/pawl": "^0.4.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
