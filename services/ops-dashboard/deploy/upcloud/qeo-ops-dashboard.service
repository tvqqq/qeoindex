[Unit]
Description=QeoIndex private operations dashboard
Requires=docker.service
After=docker.service network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
User=qeo
Group=qeo
WorkingDirectory=/opt/qeoindex/repo/services/ops-dashboard
ExecStart=/usr/bin/docker compose -p qeo-ops-dashboard -f deploy/upcloud/docker-compose.upcloud.yml up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose -p qeo-ops-dashboard -f deploy/upcloud/docker-compose.upcloud.yml down
RemainAfterExit=yes
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
