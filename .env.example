# Live Notion connection for StockOS Research + Scanner.
NOTION_API_KEY=

# Data source IDs are not secrets. Defaults are embedded in server code,
# but explicit overrides make future migrations easier.
NOTION_STOCK_THESIS_DATA_SOURCE_ID=fa161c1b-3f37-4ee2-8d75-0ca64a05ee90
NOTION_ANALYSIS_LOG_DATA_SOURCE_ID=3642cc21-8280-44e2-bad6-93f9472ce793
NOTION_WYCKOFF_UNIVERSE_DATA_SOURCE_ID=210c502d-0c32-4fdd-9d69-7ef18e2be7d5
NOTION_DAILY_WYCKOFF_SCAN_DATA_SOURCE_ID=b76e378a-3f0c-4315-82cd-52c844101b73

# DNSE historical OHLC provider. Keep these SERVER-ONLY; do not prefix new secrets with NEXT_PUBLIC_.
DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_API_BASE_URL=https://openapi.dnse.com.vn

# Protect /api/scanner/run. Vercel Cron can use CRON_SECRET instead.
SCANNER_RUN_SECRET=
CRON_SECRET=
