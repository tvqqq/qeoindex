# Optional live Notion connection for StockOS Research.
# Create an internal Notion integration, share both databases with it,
# then configure this secret in Vercel (Production + Preview).
NOTION_API_KEY=

# Data source IDs are not secrets. Defaults are already embedded in server code,
# but these overrides make migrations easier.
NOTION_STOCK_THESIS_DATA_SOURCE_ID=fa161c1b-3f37-4ee2-8d75-0ca64a05ee90
NOTION_ANALYSIS_LOG_DATA_SOURCE_ID=3642cc21-8280-44e2-bad6-93f9472ce793
