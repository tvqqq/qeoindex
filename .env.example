# Live Notion connection for StockOS Research + Scanner + Signals.
NOTION_API_KEY=

# Data source IDs are not secrets. Defaults are embedded in server code,
# but explicit overrides make future migrations easier.
NOTION_STOCK_THESIS_DATA_SOURCE_ID=fa161c1b-3f37-4ee2-8d75-0ca64a05ee90
NOTION_ANALYSIS_LOG_DATA_SOURCE_ID=3642cc21-8280-44e2-bad6-93f9472ce793
NOTION_WYCKOFF_UNIVERSE_DATA_SOURCE_ID=210c502d-0c32-4fdd-9d69-7ef18e2be7d5
NOTION_DAILY_WYCKOFF_SCAN_DATA_SOURCE_ID=b76e378a-3f0c-4315-82cd-52c844101b73
NOTION_TRADE_RECOMMENDATIONS_DATA_SOURCE_ID=22e1f263-7d3b-41e3-b73e-91df40cf2a2b
NOTION_SIGNAL_EVENTS_DATA_SOURCE_ID=c8771442-368d-4f6a-9549-4859ce869780

# Explicit operational read backend. Keep notion until the remote Supabase project is provisioned and backfilled.
STOCKOS_OPERATIONAL_BACKEND=notion
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Finhay Remote MCP. StockOS uses OAuth/PKCE and HTTP-only cookies; never expose tokens via NEXT_PUBLIC_*.
FINHAY_MCP_URL=https://mcp.fhsc.com.vn/mcp
# Optional: only set these if FHSC gives StockOS a pre-registered OAuth client.
# Otherwise StockOS attempts OAuth Dynamic Client Registration advertised by the MCP auth server.
FINHAY_OAUTH_CLIENT_ID=
FINHAY_OAUTH_CLIENT_SECRET=
FINHAY_OAUTH_SCOPE=

# DNSE historical + live signal provider. Keep these SERVER-ONLY; never prefix secrets with NEXT_PUBLIC_*.
DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_API_BASE_URL=https://openapi.dnse.com.vn
DNSE_WS_URL=wss://ws-openapi.dnse.com.vn/v1/stream?encoding=json

# Scanner / signal-job authentication. Vercel Cron sends CRON_SECRET as Authorization bearer when configured.
SCANNER_RUN_SECRET=
SIGNAL_MONITOR_SECRET=
CRON_SECRET=

# Telegram Bot API notification channel. Configure in Vercel environment, never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
