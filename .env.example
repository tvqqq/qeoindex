# QeoIndex is Supabase-first. Notion is an optional downstream research/thesis mirror.
NOTION_API_KEY=

# Optional Notion data source IDs. These identifiers are not credentials, but examples stay environment-neutral.
NOTION_STOCK_THESIS_DATA_SOURCE_ID=
NOTION_RESEARCH_SOURCES_DATA_SOURCE_ID=
NOTION_ANALYSIS_LOG_DATA_SOURCE_ID=
NOTION_WYCKOFF_RUNS_DATA_SOURCE_ID=
NOTION_WYCKOFF_SNAPSHOTS_DATA_SOURCE_ID=
NOTION_DAILY_WYCKOFF_SCAN_DATA_SOURCE_ID=
NOTION_TRADE_RECOMMENDATIONS_DATA_SOURCE_ID=
NOTION_SIGNAL_EVENTS_DATA_SOURCE_ID=

# Finhay market data/OAuth. Never expose tokens through NEXT_PUBLIC_*.
FINHAY_MCP_URL=https://mcp.fhsc.com.vn/mcp
FINHAY_OAUTH_CLIENT_ID=
FINHAY_OAUTH_CLIENT_SECRET=
FINHAY_OAUTH_SCOPE=

# DNSE historical + live provider. Server-only credentials; provider URLs are public endpoints.
DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_API_BASE_URL=https://openapi.dnse.com.vn
DNSE_WS_URL=wss://ws-openapi.dnse.com.vn/v1/stream?encoding=json

# Optional shared L2 cache for market snapshots and short-lived UI read models.
# QeoIndex remains functional when these are unset or Redis is unavailable;
# canonical Supabase/provider reads remain authoritative.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase Postgres and Realtime storage. Publishable/anon credentials are browser-safe;
# service-role credentials are server-only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# KFSP daily rating sync. Edge Function secrets only; never use NEXT_PUBLIC_*.
# KFSP_SYNC_SECRET must match the corresponding server/Vault secret.
KFSP_USERNAME=
KFSP_PASSWORD=
KFSP_SYNC_SECRET=
KFSP_MINIMUM_ROWS=50

# Machine-only scanner/monitor/market maintenance endpoints.
SCANNER_RUN_SECRET=
SIGNAL_MONITOR_SECRET=
AI_COUNCIL_RUN_SECRET=
MARKET_SYNC_SECRET=
MARKET_CACHE_ADMIN_SECRET=
# Vercel Cron may be used as the fallback secret for the machine endpoints above.
CRON_SECRET=

# Optional QStash scheduler credential. Server-only.
QSTASH_TOKEN=

# P4.1 AI Council hybrid LLM router. Server-only; deterministic Council works without this.
OPENAI_API_KEY=
AI_COUNCIL_LLM_ENABLED=true
AI_COUNCIL_LLM_BULL_MODEL=gpt-5.6-luna
AI_COUNCIL_LLM_BEAR_MODEL=gpt-5.6-luna
AI_COUNCIL_LLM_RISK_MODEL=gpt-5.6-terra
AI_COUNCIL_LLM_CHAIR_MODEL=gpt-5.6-terra
AI_COUNCIL_LLM_ESCALATION_MODEL=gpt-5.6-sol
AI_COUNCIL_LLM_FALLBACK_MODEL=gpt-5-mini
AI_COUNCIL_LLM_BULL_EFFORT=low
AI_COUNCIL_LLM_BEAR_EFFORT=low
AI_COUNCIL_LLM_RISK_EFFORT=medium
AI_COUNCIL_LLM_CHAIR_EFFORT=medium
AI_COUNCIL_LLM_ESCALATION_EFFORT=high
# Default 3, hard-capped at 6 to bound latency/cost. Optional comma-separated always-debate tickers.
AI_COUNCIL_LLM_MAX_TICKERS=3
AI_COUNCIL_LLM_TICKERS=

# QEO-81 research-report structured analysis uses these optional server-only overrides:
# RESEARCH_REPORT_AI_MODEL (default: gpt-5.6-luna)
# RESEARCH_REPORT_AI_FALLBACK_MODEL (default: gpt-5.6-terra)
# RESEARCH_REPORT_AI_REASONING_EFFORT (default: medium)
# They are intentionally comment-only because code defaults are canonical and Admin env inventory
# tracks configured deployment keys; add explicit assignments only when operators need overrides.

# QEO-82 research-report Q&A uses separate optional server-only route overrides:
# RESEARCH_REPORT_QA_MODEL (default: gpt-5.6-luna)
# RESEARCH_REPORT_QA_FALLBACK_MODEL (default: gpt-5.6-terra)
# RESEARCH_REPORT_QA_REASONING_EFFORT (default: medium)
# They remain comment-only for the same environment-inventory contract as QEO-81.

# P4.3 curated Notion research context. Default/pilot values may be overridden per deployment.
AI_COUNCIL_RESEARCH_TICKERS=

# Ops alerts through an attached Vercel Connect Slack connector.
SLACK_CONNECTOR=
SLACK_ALERT_CHANNEL=
# Optional: pin directly to a Slack channel ID and skip channel discovery.
SLACK_ALERT_CHANNEL_ID=

# Root admin Supabase Auth UUID allowlist. Server-only; comma-separated; never use email.
ROOT_ADMIN_USER_IDS=

# Canonical same-origin base used to validate root mutations.
APP_URL=https://example.com

